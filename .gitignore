cat > .gitignore <<'EOF'
# Terraform
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# AWS credentials
.aws/
credentials

# SSH private keys
*.pem
*.key
id_rsa
id_ed25519

# Secrets
.env
.env.*
*.secret
*.password

# Ansible
*.retry
vault_password_file

# PostgreSQL
*.log

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
EOF
terraform/ha-lab.tfplan
terraform/ips.json
